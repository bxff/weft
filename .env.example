# weft — environment template.
# Copy to .env (git-ignored) and fill in. Secrets are marked [SECRET]; never
# commit real values. docker-compose.yml reads this file automatically.
#
# Variables are grouped by where they're consumed:
#   1. web (build-time, PUBLIC_*)   -> set for the web build, not used by Compose
#   2. cloud (runtime)              -> consumed by the cloud container
#   3. glitchtip (runtime)          -> consumed by the GlitchTip containers

# ============================================================================
# 1. WEB (apps/web) — build-time, PUBLIC_* are embedded in the static bundle.
#    Set these in the frontend build environment.
#    Listed for completeness/local builds.
# ============================================================================

# Relay origin for the web build. Set this explicitly for self-hosting.
PUBLIC_CLOUD_URL="https://cloud.weft.example.com"

# [SECRET-ish] Clerk publishable key (safe to ship in client bundle, but
# environment-specific). Leave empty for direct Bun password-based self-hosting.
PUBLIC_CLERK_PUBLISHABLE_KEY=""

# GlitchTip/Sentry DSN for the *browser* (public DSN, safe to embed).
# Leave empty to disable browser telemetry.
PUBLIC_SENTRY_DSN=""

# Fumadocs origin; empty = docs served from /docs on the same host.
PUBLIC_DOCS_URL=""

# tldraw SDK license key (public-safe, validated client-side). Empty = dev
# builds only; production needs a trial/commercial/hobby key from tldraw.dev.
PUBLIC_TLDRAW_LICENSE_KEY=""

# ============================================================================
# 2. CLOUD (apps/cloud) — runtime, consumed by the `cloud` container.
# ============================================================================

# [SECRET] Required by the supplied Compose file. For direct Bun password mode,
# clear this value and set WEFT_PASSWORD instead.
CLERK_SECRET_KEY=""

# Direct Bun mode only: set one sign-in password instead of CLERK_SECRET_KEY.
# Set HOST=127.0.0.1 when a reverse proxy provides public access.
# WEFT_PASSWORD=
# HOST=127.0.0.1
# CLOUD_STATIC_DIR=/absolute/path/to/apps/web/build

# Optional session-signing key; otherwise the database stores a generated key.
# WEFT_JWT_SECRET=

# Optional relay backup settings: pass them to the process and mount a separate volume with Compose.
# WEFT_BACKUP_DIR=/backup
# WEFT_BACKUP_INTERVAL_MIN=60
# WEFT_BACKUP_KEEP=24

# Compose maps this to SENTRY_DSN for the relay. With direct Bun, set
# SENTRY_DSN instead. Empty = telemetry disabled.
CLOUD_SENTRY_DSN=""

# Port and DB path are set inside docker-compose.yml (8080, /data/weft.db);
# only override here if running the server outside compose.
# PORT=8080
# CLOUD_DB=/data/weft.db

# Optional tablet daemon release binaries. Without these, the relay offers no update.
# WEFT_DAEMON_RELEASE=/path/to/rmsyncd
# WEFT_DAEMON_RELEASE_ARMV7=/path/to/rmsyncd-armv7

# Optional relay limits and quotas (pass these explicitly to the container).
# Per-user storage quotas, one per data class. Notes, ink and
# edit history ("created", default 1 GiB ≈ years of handwriting) always sync.
# PDF/EPUB source files ("sources", default 3 GiB) have their own budget; past
# it the coldest stay tablet-only until reopened. 0 = explicitly unlimited.
# Per-user overrides live in the user_quotas table (PUT /api/admin/quota).
# WEFT_QUOTA_CREATED_BYTES=1073741824
# WEFT_QUOTA_SOURCES_BYTES=3221225472
# Global capacity watermark (#58): bytes of storage provisioned for user data
# on this box. At 80% of it new accounts are refused (503); at 85% ALL
# storage-growing writes are refused (507, reason "capacity") while reads and
# existing sync keep working — a full disk degrades uploads, never the server.
# 0/unset = disabled (self-host default). Set this on the hosted deploy!
# WEFT_CAPACITY_BYTES=0
# Admin user ids (#59), comma-separated: enables /api/admin/stats (uptime,
# total/per-user storage, watermark headroom, since-boot 429/507 counters) and
# PUT /api/admin/quota (per-user per-class quota overrides) for exactly those
# authenticated users. Unset/empty = the endpoints don't exist.
# WEFT_ADMIN_USERS=
# Per-user request rate limit: sustained requests/second + burst bucket.
# Defaults are far above real client behavior; only sustained hammering trips
# them (429 + Retry-After). 0 rps disables.
# WEFT_RATE_RPS=100
# WEFT_RATE_BURST=500
# /api/login brute-force bucket size (per IP; refills at 1 attempt per 2s).
# WEFT_LOGIN_RATE_BURST=10
# Max ops accepted in one POST /ops batch.
# WEFT_MAX_OPS_PER_POST=1000

# ============================================================================
# 3. GLITCHTIP — runtime, consumed by glitchtip-* containers.
# ============================================================================

# [SECRET] Postgres password for the GlitchTip database.
GLITCHTIP_POSTGRES_PASSWORD=

# [SECRET] Django secret key. Generate: openssl rand -hex 32
GLITCHTIP_SECRET_KEY=

# Public origin where GlitchTip's UI is reachable (used in emails + DSNs).
GLITCHTIP_DOMAIN="http://localhost:8000"

# Email transport. consolemail:// logs emails to the worker (good for dev /
# single-owner). For real mail: smtp://user:pass@host:587
GLITCHTIP_EMAIL_URL="consolemail://"
GLITCHTIP_FROM_EMAIL="weft@localhost"

# Allow new-user signup. Leave True to create your first (owner) account,
# then set to False to lock the instance down.
GLITCHTIP_OPEN_REGISTRATION="True"

# --- production TLS front (Caddy) ---------------------------------------
# Public domain for the cloud store (DNS A/AAAA record pointing at this VPS).
# Required only when you start Compose with --profile tls.
WEFT_DOMAIN=

# Optional invite flow: all three values must be set in the relay environment.
# WEFT_INVITE_CODE=
# WEFT_APP_URL=https://weft.example.com
# WEFT_ACCOUNTS_URL=https://accounts.weft.example.com
